# Server & App Environment Variables
PORT=3000
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL=postgres://inventory_user:inventory_secure_password@postgres:5432/inventory_db
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=inventory_secure_password
POSTGRES_DB=inventory_db

# JWT Secret for Email/Password Authentication & Sessions
JWT_SECRET=super_secret_jwt_key_please_change_in_production_32_chars_min
JWT_EXPIRES_IN=7d

# Optional AI Studio / Gemini integration
GEMINI_API_KEY=
APP_URL=
